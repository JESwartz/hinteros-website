# Cloudflare Pages response headers. Rules that match the same path add their values together
# (joined with a comma), so the Content-Security-Policy is set by exactly one rule.
# The CSP allows Cloudflare Web Analytics (static.cloudflareinsights.com, cloudflareinsights.com)
# and what the Flutter demo needs under /demo/ (WebAssembly for CanvasKit, inline styles).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/release.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The demo's files keep their names between builds (main.dart.js), so they are revalidated.
/demo/*
  Cache-Control: no-cache

# The same site on the project's pages.dev address is kept out of search engines: only
# hinteros.org is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
